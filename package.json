{
  "name": "dsh-tool-lazy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DSH 工具懒加载：按 agent 用原生 tools.restrict 掩码隐藏低频工具 schema，仅保留核心工具 + tool_search/tool_load 元工具，按需放开。",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "config.json",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2"
  },
  "author": "local",
  "license": "MIT"
}
